{
  "name": "@prereborn/companion",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:overlay-renderer && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "typecheck:overlay-renderer": "tsc --noEmit -p overlay-renderer/tsconfig.json",
    "build:overlay-renderer": "pnpm typecheck:overlay-renderer && vite build --config vite.overlay-renderer.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "motion": "^12.23.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^27.4.0",
    "sass": "^1.80.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  }
}
