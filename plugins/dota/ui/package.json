{
  "name": "@prereborn/dota-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && pnpm build:overlay",
    "build:overlay": "tsc --noEmit -p overlay/tsconfig.json && vite build --config vite.overlay.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "motion": "^12.23.26"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "sass": "^1.80.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10",
    "jsdom": "^27.4.0",
    "@testing-library/react": "^16.3.2"
  }
}
